# Copia este archivo como .env y ajusta los datos.

BUSINESS_NAME=Pakas.mx
ADVISOR_PHONE=5210000000000
CATALOG_URL=https://pakas.mx
WHOLESALE_URL=https://pakas.mx/mayoreo
TRACKING_URL=https://pakas.mx/rastreo

# Opcional. Necesario solo si el bot no encuentra Edge, Chrome o Chromium automaticamente.
# Ejemplos macOS:
# PUPPETEER_EXECUTABLE_PATH=/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge
# PUPPETEER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_EXECUTABLE_PATH=

# false/empty abre el navegador visible. true lo corre en modo invisible.
BROWSER_HEADLESS=false

# Ruta donde whatsapp-web.js guarda la sesion.
# En deploy debe apuntar a un disco persistente.
WWEBJS_AUTH_PATH=.wwebjs_auth

# false evita imprimir el QR gigante en logs de Render.
# El bot siempre imprime WHATSAPP_QR_DATA para generar una imagen limpia.
PRINT_TERMINAL_QR=true
