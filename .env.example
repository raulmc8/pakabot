# Copia este archivo como .env y ajusta los datos.

BUSINESS_NAME=Pakas.mx
ADVISOR_PHONE=5210000000000

# WhatsApp Business Platform / Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cambia-este-token
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v23.0

# Link publico del catalogo de WhatsApp Business.
# Ejemplo: https://wa.me/c/5210000000000
CATALOG_URL=

# Zona horaria y minutos sin actividad antes de cerrar la conversacion activa.
BUSINESS_TIME_ZONE=America/Mexico_City
CONVERSATION_INACTIVITY_TIMEOUT_MINUTES=5

# Puerto local. En Render se usa PORT automaticamente.
SERVER_PORT=3000
